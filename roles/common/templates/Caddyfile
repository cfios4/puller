{
#    acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
    acme_dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    storage file_system {
        root /var/lib/caddy
    }
}

(whitelist_lan) {
    @blocked not remote_ip 192.168.0.0/16 10.0.0.0/8
    abort @blocked
}

